---
import type { JourneyContent } from "@/data/content";
import SectionTitle from "@/components/astro/ui/SectionTitle.astro";

interface Props {
  journey: JourneyContent;
}

const { journey } = Astro.props;

// En la línea horizontal se lee de izquierda a derecha: del más antiguo al actual.
const experience = [...journey.experience].reverse();
const yearOf = (period: string) => period.match(/\d{4}/)?.[0] ?? period;
const untilOf = (period: string) => period.split(/—|-/)[1]?.trim() ?? '';
---

<section id="journey" class="relative">
  <div class="page-container pt-(--space-section-y) max-md:pt-(--space-section-y-mobile)">
    <SectionTitle text={journey.title} />
  </div>

  <!--
    Experiencia en horizontal.
    Por defecto (sin JS, móvil o movimiento reducido) es una lista vertical.
    En escritorio el script añade .is-pinned: la escena queda fija y el scroll vertical desplaza la línea.
  -->
  <div class="htrack" data-htrack>
    <div class="htrack__stage">
      <h3 class="htrack__label t-sub">
        {journey.experienceTitle}
      </h3>

      <div class="htrack__track" data-htrack-track>
        <div class="htrack__rail" aria-hidden="true">
          <span class="htrack__rail-fill" data-htrack-fill></span>
        </div>

        {experience.map((item) => (
          <article class="htrack__card surface" data-htrack-card>
            <span class="htrack__dot" aria-hidden="true"></span>
            <p class="m-0 flex items-baseline gap-3 leading-none">
              <span class="text-[clamp(56px,7vw,104px)] font-semibold tracking-[-0.04em] text-foreground">
                {yearOf(item.period)}
              </span>
              {untilOf(item.period) && (
                <span class="text-[15px] font-medium text-white/55">→ {untilOf(item.period)}</span>
              )}
            </p>
            <div class="mt-6 flex flex-col gap-1">
              <h4 class="m-0 text-[20px] leading-snug font-semibold tracking-[-0.02em] text-foreground md:text-[22px]">
                {item.title}
              </h4>
              <p class="m-0 text-[15px] font-semibold text-primary">{item.organization}</p>
            </div>
            <p class="m-0 mt-4 max-w-[46ch] text-[16px] leading-[1.7] text-white/70">
              {item.summary}
            </p>
            <ul class="m-0 mt-5 flex list-none flex-wrap gap-2 p-0">
              {item.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </article>
        ))}

        <a href="#contact" class="htrack__next surface group" data-htrack-card>
          <span class="text-[clamp(28px,3vw,40px)] leading-[1.15] font-medium tracking-[-0.03em] text-foreground">
            El siguiente capítulo puede ser tu proyecto.
          </span>
          <span class="link-arrow mt-6 text-[15px] group-hover:text-foreground">
            Hablemos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>

  <!-- Formación: lista compacta -->
  <div class="page-container pt-16 pb-(--space-section-y) max-md:pb-(--space-section-y-mobile) md:pt-20">
    <div>
      <h3 class="t-sub">{journey.educationTitle}</h3>
      <ul class="rows mt-5">
        {journey.education.map((item) => (
          <li class="grid gap-1 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_auto] md:items-baseline md:gap-6">
            <span class="text-[15px] font-medium text-white/55 md:order-3">{item.period}</span>
            <span class="t-sub text-[16px] md:order-1">{item.title}</span>
            <span class="text-[15px] text-white/70 md:order-2">{item.organization}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Por defecto: lista vertical ────────────────────────────── */
  .htrack__stage {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 24px;
    padding-top: 40px;
  }
  .htrack__track {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }
  .htrack__rail,
  .htrack__dot {
    display: none;
  }
  .htrack__card,
  .htrack__next {
    position: relative;
    padding: clamp(24px, 4vw, 40px);
  }
  .htrack__next {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-style: dashed;
    border-color: rgba(123, 142, 200, 0.3);
    background: transparent;
    text-decoration: none;
  }
  .htrack__next:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* ── Escritorio con animación: escena fija y desplazamiento horizontal ── */
  .htrack.is-pinned .htrack__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    max-width: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .is-pinned .htrack__label {
    padding-inline: max(24px, calc((100vw - var(--container-max)) / 2 + 24px));
  }
  .is-pinned .htrack__track {
    position: relative;
    flex-direction: row;
    align-items: stretch;
    gap: 40px;
    width: max-content;
    margin-top: 36px;
    padding-inline: max(24px, calc((100vw - var(--container-max)) / 2 + 24px));
    padding-top: 36px;
    will-change: transform;
  }
  .is-pinned .htrack__card {
    width: min(600px, 62vw);
    flex-shrink: 0;
  }
  .is-pinned .htrack__next {
    width: min(440px, 40vw);
    flex-shrink: 0;
  }
  /* Raíl superior que se rellena con el avance */
  .is-pinned .htrack__rail {
    display: block;
    position: absolute;
    top: 0;
    left: max(24px, calc((100vw - var(--container-max)) / 2 + 24px));
    right: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
  }
  .htrack__rail-fill {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    transform-origin: left center;
    transform: scaleX(0);
    border-radius: inherit;
  }
  .is-pinned .htrack__dot {
    display: block;
    position: absolute;
    top: -41px;
    left: 40px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 2px solid var(--color-primary);
    background: var(--bg-color);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const wrap = document.querySelector<HTMLElement>('[data-htrack]');
  const track = document.querySelector<HTMLElement>('[data-htrack-track]');
  const fill = document.querySelector<HTMLElement>('[data-htrack-fill]');
  const mm = gsap.matchMedia();

  mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
    if (!wrap || !track) return;
    wrap.classList.add('is-pinned');

    // Distancia horizontal a recorrer; la altura de la sección la convierte en scroll vertical.
    const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
    const setHeight = () => (wrap.style.height = `${distance() + window.innerHeight}px`);
    setHeight();
    ScrollTrigger.addEventListener('refreshInit', setHeight);

    const scrollCfg = {
      trigger: wrap,
      start: 'top top',
      end: 'bottom bottom',
      scrub: 0.5,
      invalidateOnRefresh: true,
    };

    const move = gsap.to(track, { x: () => -distance(), ease: 'none', scrollTrigger: scrollCfg });
    if (fill) gsap.to(fill, { scaleX: 1, ease: 'none', scrollTrigger: { ...scrollCfg } });

    // Cada tarjeta se enciende al llegar al centro de la pantalla.
    gsap.utils.toArray<HTMLElement>('[data-htrack-card]', wrap).forEach((card) => {
      gsap.fromTo(
        card,
        { opacity: 0.3 },
        {
          opacity: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: card,
            containerAnimation: move,
            start: 'left 80%',
            end: 'left 45%',
            scrub: true,
          },
        }
      );
    });

    ScrollTrigger.refresh();

    return () => {
      ScrollTrigger.removeEventListener('refreshInit', setHeight);
      wrap.classList.remove('is-pinned');
      wrap.style.height = '';
    };
  });
</script>
