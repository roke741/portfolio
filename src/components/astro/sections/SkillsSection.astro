---
import type { SkillCard } from "@/data/content";
import SectionTitle from "@/components/astro/ui/SectionTitle.astro";

interface Props {
  title: string;
  columns: SkillCard[][];
}

const { title, columns } = Astro.props;
const groups = columns.flat().map((group) => ({
  title: group.title,
  items: group.content.split('·').map((s) => s.trim()).filter(Boolean),
}));
---

<section id="skills" class="relative">
  <div class="page-container section-shell">
    <SectionTitle text={title} />
    <ul class="rows">
      {groups.map((group) => (
        <li class="grid gap-3 md:grid-cols-[14rem_1fr] md:items-baseline md:gap-6">
          <h3 class="t-sub">{group.title}</h3>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {group.items.map((item) => <li class="chip">{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
