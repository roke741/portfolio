---
import type { ContactContent } from "@/data/content";
import SectionTitle from "@/components/astro/ui/SectionTitle.astro";
import { Send } from '@lucide/astro';

interface Props {
  contact: ContactContent;
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
}

const { contact, email, githubUrl, linkedinUrl } = Astro.props;
const mailtoHref = email ? `mailto:${email}` : null;
---

<section id="contact" class="relative">
  <div class="page-container section-shell">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">

      <!-- Izquierda: invitación y contacto directo -->
      <div>
        <SectionTitle text={contact.title} subtitle="¿Tienes un proyecto en mente? Cuéntamelo y te respondo en breve." />
        <div class="flex flex-col gap-5">
          {mailtoHref && (
            <a href={mailtoHref} class="link-arrow text-[16px]">
              {email}
            </a>
          )}
          <div class="flex gap-3">
            {githubUrl && githubUrl !== '#' && (
              <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
          </svg>
              </a>
            )}
            {linkedinUrl && linkedinUrl !== '#' && (
              <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/>
          </svg>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Derecha: formulario -->
      <div class="surface relative overflow-hidden p-6 md:p-8">
        <div
          id="contact-success"
          class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-space-950/95 p-6 text-center"
          role="status"
          aria-live="polite"
          hidden
        >
          <span class="flex size-12 items-center justify-center rounded-full border border-accent/40 text-accent" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <p class="t-sub m-0 text-[19px]">Mensaje enviado</p>
          <p class="m-0 text-[15px] text-white/70">Gracias, te responderé pronto a tu correo.</p>
          <button type="button" id="contact-again" class="btn-secondary mt-3 h-10 px-4 text-[14px]">Enviar otro mensaje</button>
        </div>

        <form id="contact-form" action="#" method="post" class="flex flex-col gap-5" novalidate>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="contact-name" class="text-[14px] font-medium text-white/75">{contact.nameLabel}</label>
              <input id="contact-name" name="name" type="text" placeholder="Tu nombre" class="input-shell h-12 px-4" autocomplete="name" maxlength="120" required />
            </div>
            <div class="flex flex-col gap-2">
              <label for="contact-email" class="text-[14px] font-medium text-white/75">{contact.emailLabel}</label>
              <input id="contact-email" name="email" type="email" placeholder="tu@correo.com" class="input-shell h-12 px-4" autocomplete="email" maxlength="160" required />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label for="contact-message" class="text-[14px] font-medium text-white/75">{contact.messageLabel}</label>
            <textarea id="contact-message" name="message" placeholder={contact.messagePlaceholder} class="input-shell min-h-40 resize-y px-4 py-3.5" minlength="10" maxlength="4000" required></textarea>
          </div>

          <p id="contact-error" class="m-0 text-[14px] text-rose-300 empty:hidden" role="alert"></p>

          <button id="contact-submit" type="submit" class="btn-primary w-full md:w-fit">
            <span id="contact-btn-default" class="flex items-center gap-2">
              <Send size={16} stroke-width={2} aria-hidden="true" />
              {contact.submitLabel}
            </span>
            <span id="contact-btn-loading" class="hidden items-center gap-2">
              <span class="contact-spinner size-4 shrink-0 rounded-full border-2 border-space-950/25 border-t-space-950"></span>
              Enviando…
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes contact-spin {
    to { transform: rotate(360deg); }
  }
  .contact-spinner {
    display: inline-block;
    animation: contact-spin 0.72s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-spinner { animation-duration: 2s; }
  }
</style>

<script>
  const contactEmail = document.querySelector<HTMLAnchorElement>('#contact a[href^="mailto:"]')?.textContent?.trim();

  const form      = document.getElementById('contact-form')    as HTMLFormElement | null;
  const submit    = document.getElementById('contact-submit')  as HTMLButtonElement | null;
  const defEl     = document.getElementById('contact-btn-default')  as HTMLElement | null;
  const loadEl    = document.getElementById('contact-btn-loading')  as HTMLElement | null;
  const successEl = document.getElementById('contact-success')      as HTMLElement | null;
  const errorEl   = document.getElementById('contact-error')        as HTMLElement | null;
  const againBtn  = document.getElementById('contact-again')        as HTMLButtonElement | null;

  const fallback = contactEmail ? ` También puedes escribirme directamente a ${contactEmail}.` : '';

  const setLoading = (loading: boolean) => {
    if (!submit || !defEl || !loadEl) return;
    submit.disabled = loading;
    defEl.classList.toggle('hidden', loading);
    loadEl.classList.toggle('hidden', !loading);
    loadEl.classList.toggle('flex', loading);
  };

  if (form && submit && successEl && errorEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.textContent = '';
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? '').trim(),
        email: String(formData.get('email') ?? '').trim(),
        message: String(formData.get('message') ?? '').trim(),
      };

      setLoading(true);
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        // El servidor puede responder HTML (p. ej. un 500): no mostrar ese texto técnico.
        const data = (await response.json().catch(() => ({}))) as { success?: boolean; message?: string };
        if (!response.ok || !data.success) {
          throw new Error(data.message || 'No se pudo enviar el mensaje.');
        }
      } catch (error) {
        const offline = !navigator.onLine;
        const base = offline
          ? 'Parece que no tienes conexión. Revisa tu red e inténtalo de nuevo.'
          : error instanceof Error && !/JSON|token|fetch/i.test(error.message)
            ? error.message
            : 'No se pudo enviar el mensaje.';
        errorEl.textContent = base + fallback;
        setLoading(false);
        return;
      }

      // Éxito: queda visible hasta que la persona decida enviar otro mensaje.
      setLoading(false);
      form.reset();
      successEl.hidden = false;
      againBtn?.focus();
    });

    againBtn?.addEventListener('click', () => {
      successEl.hidden = true;
      document.getElementById('contact-name')?.focus();
    });
  }
</script>
