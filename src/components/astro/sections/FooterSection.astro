---
import type { FooterContent } from "@/data/content";
import { Facebook, Github, Instagram, Linkedin } from '@lucide/astro';

interface Props {
  footer: FooterContent;
}

const { footer } = Astro.props;

const socialIconMap: Record<string, any> = {
  facebook: Facebook,
  github: Github,
  linkedin: Linkedin,
  instagram: Instagram,
};
---

<footer class="border-t border-white/8">
  <div class="page-container py-12 md:py-16">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-2">
        <p class="m-0 text-[17px] font-bold tracking-[-0.02em] text-foreground">{footer.name}</p>
        <p class="m-0 text-[15px] text-white/70">{footer.roles.join(' · ')}</p>
        <a href={`mailto:${footer.email}`} class="link-arrow mt-2 text-[15px]">{footer.email}</a>
      </div>

      <ul class="m-0 flex list-none flex-wrap gap-3 p-0" aria-label="Redes sociales">
        {footer.socialLinks.map((social) => {
          const key = social.label.toLowerCase();
          const Icon = socialIconMap[key];
          return (
            <li>
              <a
                href={social.href}
                aria-label={social.label}
                title={social.label}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-icon"
              >
                {Icon ? (
                  <Icon size={18} stroke-width={2} aria-hidden="true" />
                ) : key === 'x' ? (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z" />
                  </svg>
                ) : (
                  <span class="text-[13px] font-semibold">{social.label.slice(0, 2)}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/8 pt-6 text-[13px] text-white/55 md:flex-row md:justify-between">
      <p class="m-0">{footer.signature}</p>
      <p class="m-0">{footer.copyright}</p>
    </div>
  </div>
</footer>
