---
import { getCollection, render } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/astro/sections/Header.astro';
import FooterSection from '@/components/astro/sections/FooterSection.astro';
import { StarsBackground } from '@/components/react/ui/stars-background';
import { ShootingStars } from '@/components/react/ui/shooting-stars';
import { footer, header, seo, type SeoMetadata } from '@/data/content';
import { ArrowLeft, Calendar, Clock, Tag } from '@lucide/astro';
import '@/styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const formattedDate = new Intl.DateTimeFormat('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);

const words = post.body ? post.body.trim().split(/\s+/).length : 300;
const readingMinutes = Math.max(1, Math.round(words / 200));

const postSeo: SeoMetadata = {
  ...seo,
  title: `${post.data.title} | Jhordie Roque`,
  description: post.data.description,
  canonical: `https://jhordie.me/blog/${post.id}`,
  ogImage: post.data.heroImage || seo.ogImage,
};

const relevantHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<MainLayout seo={postSeo}>
  <Header brand={header.brand} navItems={header.navItems} />

  <div class="stars-wrapper min-h-screen">
    <StarsBackground client:load />
    <ShootingStars client:load />

    <div class="stars-wrapper__content">
      <article class="mx-auto max-w-4xl px-4 pt-32 pb-24 sm:px-6 lg:px-8">
        <!-- Back button -->
        <div class="mb-8">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-medium text-slate-300 backdrop-blur-md transition-all hover:border-[#7b8ec8]/50 hover:bg-white/10 hover:text-white"
          >
            <ArrowLeft class="h-3.5 w-3.5" />
            <span>Volver a todas las publicaciones</span>
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-12 border-b border-white/10 pb-10">
          <div class="mb-4 flex flex-wrap items-center gap-3 text-xs text-slate-400">
            <span class="inline-flex items-center gap-1.5 font-medium text-slate-300">
              <Calendar class="h-3.5 w-3.5 text-[#7b8ec8]" />
              <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            </span>

            <span class="text-white/20">•</span>

            <span class="inline-flex items-center gap-1.5 text-slate-300">
              <Clock class="h-3.5 w-3.5 text-[#7b8ec8]" />
              <span>{readingMinutes} min de lectura</span>
            </span>

            {post.data.tags.length > 0 && (
              <>
                <span class="text-white/20">•</span>
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-[11px] font-medium text-slate-300 border border-white/10">
                      #{tag}
                    </span>
                  ))}
                </div>
              </>
            )}
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight">
            {post.data.title}
          </h1>

          <p class="mt-5 text-lg leading-relaxed text-slate-300/90 font-light">
            {post.data.description}
          </p>

          {post.data.heroImage && (
            <div class="mt-8 overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full object-cover max-h-[440px]"
              />
            </div>
          )}
        </header>

        <!-- Optional Table of contents -->
        {relevantHeadings.length > 2 && (
          <aside class="mb-12 rounded-2xl border border-white/10 bg-[var(--bg-surface)]/60 p-6 backdrop-blur-md">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-[#7b8ec8] mb-3">
              En este artículo
            </h2>
            <nav aria-label="Tabla de contenidos">
              <ul class="space-y-2 text-sm">
                {relevantHeadings.map((heading) => (
                  <li class={heading.depth === 3 ? 'ml-4' : ''}>
                    <a
                      href={`#${heading.slug}`}
                      class="text-slate-300/80 transition-colors hover:text-white hover:underline"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        <!-- Main Markdown Content -->
        <div class="blog-prose">
          <Content />
        </div>

        <!-- Post footer CTA -->
        <div class="mt-16 border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-white/10 hover:border-[#7b8ec8]/50"
          >
            <ArrowLeft class="h-4 w-4" />
            <span>Ver más artículos</span>
          </a>

          <a
            href="/#contact"
            class="inline-flex items-center gap-2 text-sm font-medium text-[#7b8ec8] transition-colors hover:text-white"
          >
            <span>¿Tienes alguna pregunta o comentario? Hablemos →</span>
          </a>
        </div>
      </article>

      <FooterSection footer={footer} />
    </div>
  </div>
</MainLayout>

<style>
  .stars-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg-color);
  }

  .stars-wrapper__content {
    position: relative;
    z-index: 1;
  }
</style>
