---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/astro/sections/Header.astro';
import FooterSection from '@/components/astro/sections/FooterSection.astro';
import BlogCard from '@/components/astro/ui/BlogCard.astro';
import { StarsBackground } from '@/components/react/ui/stars-background';
import { ShootingStars } from '@/components/react/ui/shooting-stars';
import { footer, header, seo, type SeoMetadata } from '@/data/content';
import { BookOpen } from '@lucide/astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));

const blogSeo: SeoMetadata = {
  ...seo,
  title: 'Blog & Artículos | Jhordie Roque',
  description: 'Artículos sobre desarrollo de software, arquitectura web, rendimiento y buenas prácticas sin rodeos.',
  canonical: 'https://jhordie.me/blog',
};
---

<MainLayout seo={blogSeo}>
  <Header brand={header.brand} navItems={header.navItems} />

  <div class="stars-wrapper min-h-screen">
    <StarsBackground client:load />
    <ShootingStars client:load />

    <div class="stars-wrapper__content">
      <main class="mx-auto max-w-5xl px-4 pt-32 pb-24 sm:px-6 lg:px-8">
        <!-- Hero Blog Section -->
        <header class="mb-14 text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-[#7b8ec8] backdrop-blur-md mb-4">
            <BookOpen class="h-3.5 w-3.5" />
            <span>Publicaciones & Notas</span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
            Blog & <span class="bg-gradient-to-r from-white via-slate-200 to-[#7b8ec8] bg-clip-text text-transparent">Artículos</span>
          </h1>

          <p class="mx-auto mt-4 max-w-2xl text-base text-slate-300/80 sm:text-lg">
            Ideas, guías prácticas y reflexiones sobre desarrollo web, arquitectura de software, rendimiento y herramientas modernas.
          </p>

          <!-- Tags list -->
          {allTags.length > 0 && (
            <div class="mt-8 flex flex-wrap justify-center gap-2">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium text-slate-400">
                Temas:
              </span>
              {allTags.map((tag) => (
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300 backdrop-blur-sm transition-colors hover:border-[#7b8ec8]/50 hover:text-white">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <!-- Articles Grid -->
        {posts.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {posts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-12 text-center backdrop-blur-md">
            <p class="text-lg text-slate-300">Aún no hay publicaciones disponibles.</p>
            <p class="mt-2 text-sm text-slate-400">¡Vuelve pronto para leer nuevos artículos!</p>
          </div>
        )}
      </main>

      <FooterSection footer={footer} />
    </div>
  </div>
</MainLayout>

<style>
  .stars-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--bg-color);
  }

  .stars-wrapper__content {
    position: relative;
    z-index: 1;
  }
</style>
